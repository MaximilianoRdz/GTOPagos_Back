# ====================================================
# GTOPagos Backend - Plantilla de Variables de Entorno
# Copia este archivo a '.env' y completa con tus valores
# ====================================================

# Django Core
DEBUG=False
DJANGO_SECRET_KEY=genera_aqui_tu_django_secret_key_segura
ALLOWED_HOSTS=localhost,127.0.0.1,backend,api.tudominio.com
CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app,http://localhost:4200

# Base de Datos PostgreSQL
DB_NAME=gtopagos
DB_USER=postgres
DB_PASSWORD=tu_password_de_base_de_datos
DB_HOST=db
DB_PORT=5432
DB_EXTERNAL_PORT=5434

# Configuración Nginx y Bóveda Proxy
FRONTEND_URL=https://tu-frontend.vercel.app
PROXY_VAULT_KEY=genera_aqui_tu_clave_secreta_de_boveda
NGINX_PORT=80
EXTERNAL_PORT=1451
PROXY_PORT=1450

# Servidor de Correo (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion
DEFAULT_FROM_EMAIL=GTOPagos <tu_correo@gmail.com>
